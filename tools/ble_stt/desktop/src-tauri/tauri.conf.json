{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "M5StopWatch",
  "version": "0.3.3",
  "identifier": "com.aporicho.m5stopwatch-ble-stt",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare-sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "M5StopWatch",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "M5StopWatch speech helper control panel",
    "longDescription": "Cross-platform desktop control panel for the M5StopWatch BLE speech helper.",
    "resources": [
      "resources/ble-stt-helper/",
      "resources/models/"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
